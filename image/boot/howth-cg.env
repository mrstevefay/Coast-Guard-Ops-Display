# Howth CG dashboard — edit this file on the SD card's boot partition from any
# laptop (it is the FAT partition named "bootfs"). Lines are KEY=value.
# Changes apply on next boot, or: sudo systemctl restart howth-cg-dashboard

# Required for callout / stand-down (Phase 2 WhatsApp bridge). Long random string.
CALLOUT_TOKEN=change-me-to-a-long-random-string

# Free key from https://aisstream.io — enables the AIS vessel panel.
AISSTREAM_API_KEY=

# Dublin Bay buoy (dublinbaybuoy.com) publishable key; a default is baked into config.yaml.
#DUBLINBAY_API_KEY=

# Optional still-image URL for the webcam panel.
WEBCAM_IMAGE_URL=

# Any config.yaml key can be overridden, e.g.
# CFG__panels__webcam=false
# CFG__callout__autoStanddownMinutes=120
