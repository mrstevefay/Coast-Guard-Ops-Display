# Howth CG dashboard — edit this file on the SD card's boot partition from any
# laptop (it is the FAT partition named "bootfs"). Lines are KEY=value.
# Changes apply on next boot, or: sudo systemctl restart howth-cg-dashboard

# Required for callout / stand-down (Phase 2 WhatsApp bridge). Long random string.
CALLOUT_TOKEN=change-me-to-a-long-random-string

# Password for the Wi-Fi page at http://howth-cg.local:8080/device/ (change Wi-Fi
# from a phone). Blank = use CALLOUT_TOKEN. Pick something you can type.
DEVICE_PASSWORD=

# Tailscale (remote access). Create an auth key at login.tailscale.com → Settings →
# Keys (one-off, not ephemeral). The Pi joins on first boot as TAILSCALE_HOSTNAME,
# with Tailscale SSH on, then this key is blanked. Leave empty to skip.
TAILSCALE_AUTHKEY=
#TAILSCALE_HOSTNAME=howth-cg

# Free key from https://aisstream.io — enables the AIS vessel panel.
AISSTREAM_API_KEY=

# Dublin Bay buoy (dublinbaybuoy.com) publishable key; a default is baked into config.yaml.
#DUBLINBAY_API_KEY=

# Optional still-image URL for the webcam panel.
WEBCAM_IMAGE_URL=

# Hosted server (Phase 2): the Pi mirrors it for the TV and falls back to local
# feeds if it is unreachable. Create a display key in the crew app (More → Admin).
#UPSTREAM_URL=wss://ops.example.ie
#UPSTREAM_KEY=dk_...

# Any config.yaml key can be overridden, e.g.
# CFG__panels__webcam=false
# CFG__callout__autoStanddownMinutes=120
