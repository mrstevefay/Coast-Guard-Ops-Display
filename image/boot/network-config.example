# Wi-Fi for first boot (cloud-init / netplan format, Raspberry Pi OS Trixie).
# Rename this file to  network-config  (no extension) and fill in your network.
# Ethernet needs nothing. Applied on FIRST boot only.
network:
  version: 2
  renderer: NetworkManager
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      access-points:
        "STATION-SSID":
          password: "STATION-PASSWORD"
          priority: 10
        # Optional second network, e.g. for bench testing at home.
        "HOME-SSID":
          password: "HOME-PASSWORD"
