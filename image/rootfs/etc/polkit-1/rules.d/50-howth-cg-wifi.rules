// Lets the dashboard server (user howthcg) scan for and join Wi-Fi networks through
// NetworkManager, for the device page at http://<pi>:8080/device/. Nothing else.
polkit.addRule(function (action, subject) {
  if (subject.user !== "howthcg") return polkit.Result.NOT_HANDLED;
  var allowed = [
    "org.freedesktop.NetworkManager.network-control",
    "org.freedesktop.NetworkManager.settings.modify.system",
    "org.freedesktop.NetworkManager.wifi.scan"
  ];
  return allowed.indexOf(action.id) >= 0 ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
});
