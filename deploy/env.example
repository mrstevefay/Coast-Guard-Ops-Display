# /opt/howth-cg/.env on the VPS — copy and fill in. docker compose reads it.
DOMAIN=ops.example.ie
PUBLIC_URL=https://ops.example.ie
IMAGE=ghcr.io/mrstevefay/howth-cg-dashboard:latest

# Accounts on (false) — the Pi runs with AUTH_OPEN=true on the LAN.
AUTH_OPEN=false

# First run only: creates the admin if the users table is empty, then remove these lines.
ADMIN_EMAIL=steve@example.ie
ADMIN_PASSWORD=change-me-now-please
ADMIN_NAME=Steve

# Callout/stand-down token for the pager/WhatsApp bridge (Phase 2b).
CALLOUT_TOKEN=change-me-to-a-long-random-string

# Feeds — or set these later from the console: /sm/ -> Settings -> Data feeds (overrides these).
AISSTREAM_API_KEY=
WEBCAM_IMAGE_URL=
#DUBLINBAY_API_KEY=
