{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# OSM tiles need a Referer (tile usage policy) — same-origin would strip it and tiles come back "Access blocked".
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# WebSocket upgrades on /api/ws pass through reverse_proxy by default.
	reverse_proxy app:8080
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
